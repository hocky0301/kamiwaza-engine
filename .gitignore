# OS
.DS_Store

# ローカル環境変数(APIキーはコミットしない)
.env
.env.local
.env*.local

# 開発ツールのローカル設定(権限グラントなど個人環境固有)
.claude/settings.local.json

# 実在企業の実書類(取引先名・金額・個人情報を含む)— 絶対にコミットしない
会社書類_*/

# app/ 以下のビルド成果物・依存は app/.gitignore で管理

# 実書類分析の完全版レポート(取引先実名・実パスを含む)— コミットしない
docs_private/

# Officeの一時ロックファイル
~$*

# ピッチ機械チェックの抽出結果(pitch/check_deck.py)
pitch/.check_out/
